{
    "name": "afaztech/reactor-ad",
    "description": "Headless random and start ad delivery for Reactor bots.",
    "type": "reactor-package",
    "license": "MIT",
    "keywords": [
        "afaztech",
        "reactor",
        "telegram",
        "telegram-bot",
        "ad",
        "advertising",
        "promotion"
    ],
    "authors": [
        {
            "name": "Abolfazl Majidi (Afaz)",
            "email": "contact@afaz.me",
            "homepage": "https://afaz.me"
        }
    ],
    "require": {
        "php": ">=8.1",
        "afaztech/reactor-framework": "^0.5.0"
    },
    "autoload": {
        "psr-4": {
            "AfazTech\\ReactorAd\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        },
        "reactor": {
            "providers": [
                "AfazTech\\ReactorAd\\AdServiceProvider"
            ],
            "migrations_namespace": "AfazTech\\ReactorAd\\Migrations"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
